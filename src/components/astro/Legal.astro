---
// Shared wrapper for legal pages: readable width, clear headings, footer.
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteFooter from './SiteFooter.astro';
interface Props { title: string; updated: string; description: string; }
const { title, updated, description } = Astro.props;
---
<BaseLayout title={title} description={description} canonical={Astro.url.pathname}>
  <header class="border-b border-slate-200 bg-white">
    <nav class="mx-auto flex max-w-3xl items-center justify-between px-4 py-4" aria-label="Main">
      <a href="/" class="text-xl font-extrabold tracking-tight text-brand-600">Doddo</a>
      <a href="/pricing" class="inline-flex min-h-11 items-center text-sm font-medium text-slate-600 hover:text-slate-900">Pricing</a>
    </nav>
  </header>
  <main id="main" class="mx-auto max-w-3xl px-4 py-12">
    <h1 class="text-3xl font-extrabold tracking-tight">{title}</h1>
    <p class="mt-2 text-sm text-slate-500">Last updated {updated}</p>
    <div class="legal mt-8 space-y-5 text-[15px] leading-relaxed text-slate-700">
      <slot />
    </div>
  </main>
  <SiteFooter />
</BaseLayout>
<style is:global>
  .legal h2 { margin-top: 2rem; font-size: 1.125rem; font-weight: 700; color: #0f172a; }
  .legal ul { list-style: disc; padding-left: 1.25rem; display: grid; gap: .35rem; }
</style>
