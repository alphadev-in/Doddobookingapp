---
interface Props { label: string; value: string | number; hint?: string; tone?: 'default' | 'warn'; }
const { label, value, hint, tone = 'default' } = Astro.props;
---
<div class="rounded-xl bg-white p-4 shadow-sm ring-1 ring-slate-200">
  <p class="text-xs font-medium uppercase tracking-wide text-slate-500">{label}</p>
  <p class:list={['mt-1 text-2xl font-semibold', tone === 'warn' ? 'text-rose-600' : 'text-slate-900']}>{value}</p>
  {hint && <p class="mt-1 text-xs text-slate-500">{hint}</p>}
</div>
