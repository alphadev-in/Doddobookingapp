---
interface Props { title: string; body?: string; }
const { title, body } = Astro.props;
---
<div class="rounded-xl border border-dashed border-slate-300 bg-white p-8 text-center">
  <p class="font-medium text-slate-800">{title}</p>
  {body && <p class="mt-1 text-sm text-slate-500">{body}</p>}
  <div class="mt-4"><slot /></div>
</div>
