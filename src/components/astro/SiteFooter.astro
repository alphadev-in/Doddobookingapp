---
import Logo from './Logo.astro';
// Site-wide footer: business sign-up, product, popular locations and legal.
import { COUNTRIES, SERVICES, slugify } from '../../lib/seo-data';
const year = new Date().getFullYear();
// A short, curated set of popular location pages. The full set is on /locations.
const popular = [
  ['uk', 'London', 'barber'], ['uk', 'Manchester', 'hair-salon'], ['uk', 'Birmingham', 'beauty-salon'],
  ['uk', 'Edinburgh', 'nail-salon'], ['us', 'New York', 'barber'], ['us', 'Los Angeles', 'hair-salon'],
  ['ca', 'Toronto', 'barber'], ['au', 'Sydney', 'hair-salon'], ['ie', 'Dublin', 'barber'], ['uk', 'Bristol', 'personal-trainer'],
];
const labelFor = (slug: string) => SERVICES.find((s) => s.slug === slug)?.name ?? slug;
---
<footer class="border-t border-slate-200 bg-white">
  <div class="mx-auto max-w-6xl px-4 pt-12">
    <div class="flex flex-col gap-6 rounded-3xl bg-gradient-to-br from-brand-600 to-blue-800 p-8 text-white md:flex-row md:items-center md:justify-between md:p-10">
      <div>
        <h2 class="text-2xl font-bold">Run your business from one link</h2>
        <p class="mt-1 text-blue-100">Business sign-up takes about five minutes. £5 a month, no contract.</p>
      </div>
      <a href="/signup" class="inline-flex min-h-12 shrink-0 items-center justify-center rounded-xl bg-white px-6 font-semibold text-brand-700 hover:-translate-y-0.5">Create business account</a>
    </div>
  </div>

  <div class="mx-auto grid max-w-6xl gap-10 px-4 py-12 sm:grid-cols-2 lg:grid-cols-4">
    <div class="sm:col-span-2 lg:col-span-1">
      <Logo />
      <p class="mt-3 max-w-xs text-sm text-slate-600">Online booking, calendar and deposits for appointment businesses.</p>
    </div>
    <nav aria-label="Product">
      <h2 class="text-sm font-semibold text-slate-900">Product</h2>
      <ul class="mt-3 space-y-1 text-sm text-slate-600">
        <li><a class="inline-flex min-h-11 items-center hover:text-slate-900" href="/features">Features</a></li>
        <li><a class="inline-flex min-h-11 items-center hover:text-slate-900" href="/pricing">Pricing</a></li>
        <li><a class="inline-flex min-h-11 items-center hover:text-slate-900" href="/#faq">FAQ</a></li>
        <li><a class="inline-flex min-h-11 items-center hover:text-slate-900" href="/signup">Business sign up</a></li>
        <li><a class="inline-flex min-h-11 items-center hover:text-slate-900" href="/login">Sign in</a></li>
      </ul>
    </nav>
    <nav aria-label="Popular locations" class="lg:col-span-1">
      <h2 class="text-sm font-semibold text-slate-900">Popular locations</h2>
      <ul class="mt-3 space-y-1 text-sm text-slate-600">
        {popular.map(([c, city, svc]) => (
          <li><a class="inline-flex min-h-11 items-center hover:text-slate-900" href={`/${c}/${slugify(city)}/${svc}`}>{labelFor(svc)} in {city}</a></li>
        ))}
        <li><a class="inline-flex min-h-11 items-center font-semibold text-brand-700 hover:underline" href="/locations">Browse all locations →</a></li>
      </ul>
    </nav>
    <nav aria-label="Legal">
      <h2 class="text-sm font-semibold text-slate-900">Legal</h2>
      <ul class="mt-3 space-y-1 text-sm text-slate-600">
        <li><a class="inline-flex min-h-11 items-center hover:text-slate-900" href="/terms">Terms & conditions</a></li>
        <li><a class="inline-flex min-h-11 items-center hover:text-slate-900" href="/privacy">Privacy policy</a></li>
      </ul>
    </nav>
  </div>
  <div class="border-t border-slate-200">
    <div class="mx-auto flex max-w-6xl flex-col gap-2 px-4 py-6 text-xs text-slate-500 sm:flex-row sm:justify-between">
      <p>© {year} Aelius Venture Limited. All rights reserved.</p>
      <p>Doddo is created and managed by Aelius Venture Limited.</p>
    </div>
  </div>
</footer>
