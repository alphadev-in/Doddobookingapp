---
import BaseLayout from '../layouts/BaseLayout.astro';
import AuthShell from '../components/astro/AuthShell.astro';
import AuthForm from '../components/islands/AuthForm';
export const prerender = false;
const next = Astro.url.searchParams.get('next') ?? '/dashboard';
---
<BaseLayout title="Sign in" noindex>
  <AuthShell title="Welcome back" subtitle="Sign in to manage your business or see your bookings.">
    <AuthForm mode="login" next={next} client:load />
    <Fragment slot="footer">New to Doddo? <a class="font-semibold text-brand-700 hover:underline" href="/signup">Create an account</a></Fragment>
  </AuthShell>
</BaseLayout>
