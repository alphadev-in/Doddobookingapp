---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteFooter from '../components/astro/SiteFooter.astro';
export const prerender = true;

const groups = [
  { title: 'Online booking', items: [
    ['Your booking page', 'One link clients can open on any phone. Share it on Instagram, Google and your website.'],
    ['Clients pick the time', 'Clients choose a service, a team member and a free slot. No back-and-forth messages.'],
    ['Slot length you choose', 'Offer start times every 5, 10, 15, 20, 30 or 60 minutes.'],
    ['Buffers built in', 'Set prep and clean-up time for each service so back-to-back bookings never clash.'],
  ]},
  { title: 'Calendar & team', items: [
    ['Day and week views', 'See the whole week at once, or switch to day view with a column for each team member.'],
    ['Unlimited team members', 'Add everyone who works at your location, each with their own colour, hours and services.'],
    ['Walk-ins and blocks', 'Add a walk-in or phone booking in seconds, and block lunch, training or closures.'],
    ['Reschedule with a tap', 'Move appointments, change status to completed or no-show, and keep notes on each one.'],
  ]},
  { title: 'Clients & CRM', items: [
    ['Client records', 'Every client is saved automatically with visits, total spend and no-show count.'],
    ['Private staff notes', 'Notes are visible only to your team. Clients never see them.'],
    ['Client history', 'See every past and upcoming appointment for each client in one place.'],
  ]},
  { title: 'Deposits & policies', items: [
    ['Deposits per service', 'Take a percentage or fixed deposit for services that need protecting.'],
    ['Turn payments on or off', 'Switch the payment step off for clients who pay in person.'],
    ['Cancellation window', 'Set the hours before an appointment that count as a late cancellation.'],
  ]},
  { title: 'Messages & notifications', items: [
    ['Email and SMS', 'Confirmations, 24-hour reminders and cancellation notices, sent automatically.'],
    ['In-app notifications', 'A bell that shows new bookings and changes. Tap one to go straight to it.'],
  ]},
  { title: 'Services & setup', items: [
    ['Import and export', 'Download your service list as a spreadsheet, edit it, and import it back.'],
    ['Categories', 'Group services and rename a category in one step.'],
    ['Works like an app', 'Install Doddo on your phone home screen. It opens full-screen, like a native app.'],
  ]},
];
const jsonLd = { '@context': 'https://schema.org', '@type': 'WebPage', name: 'Doddo features', url: 'https://doddo.co.uk/features', description: 'Features of Doddo: online booking, team calendar, client records, deposits and reminders.' };
---
<BaseLayout title="Features: booking, calendar, clients & deposits" description="Everything in Doddo: online booking, unlimited team members, calendar, client records, deposits, reminders and an app for your phone." canonical="/features" jsonLd={jsonLd}>
  <header class="sticky top-0 z-40 border-b border-slate-200/70 bg-white/85 backdrop-blur-md">
    <nav class="mx-auto flex max-w-6xl items-center justify-between px-4 py-3" aria-label="Main">
      <a href="/" class="font-logo text-xl font-bold tracking-tight text-brand-600">Doddo</a>
      <div class="flex items-center gap-1 sm:gap-2">
        <a href="/pricing" class="hidden min-h-11 items-center rounded-lg px-3 text-sm font-medium text-slate-600 hover:text-slate-900 md:inline-flex">Pricing</a>
        <a href="/login" class="inline-flex min-h-11 items-center rounded-lg px-3 text-sm font-medium text-slate-700 hover:bg-slate-100">Sign in</a>
        <a href="/signup" class="inline-flex min-h-11 items-center rounded-lg bg-brand-600 px-4 text-sm font-semibold text-white hover:bg-brand-700">Get started</a>
      </div>
    </nav>
  </header>
  <main id="main">
    <section class="px-4 pt-16 pb-12 text-center">
      <p class="anim-fade-up text-sm font-semibold uppercase tracking-wider text-brand-600">Features</p>
      <h1 class="anim-fade-up mx-auto mt-3 max-w-3xl text-4xl font-extrabold tracking-tight md:text-5xl" style="animation-delay:.05s">Everything your business needs, in one app</h1>
      <p class="anim-fade-up mx-auto mt-4 max-w-2xl text-lg text-slate-600" style="animation-delay:.1s">Bookings, calendar, clients, deposits and reminders, for £5 a month with no contract.</p>
    </section>
    <section class="mx-auto max-w-6xl space-y-14 px-4 pb-20">
      {groups.map((g) => (
        <div>
          <h2 class="reveal text-2xl font-bold tracking-tight">{g.title}</h2>
          <ul class="mt-6 grid gap-4 sm:grid-cols-2">
            {g.items.map(([t, d]) => (
              <li class="reveal rounded-2xl border border-slate-200 bg-white p-6 transition hover:-translate-y-0.5 hover:border-brand-300 hover:shadow-lg hover:shadow-brand-600/10">
                <h3 class="font-semibold">{t}</h3>
                <p class="mt-2 text-slate-600">{d}</p>
              </li>
            ))}
          </ul>
        </div>
      ))}
      <div class="reveal rounded-3xl bg-gradient-to-br from-brand-600 to-blue-800 p-8 text-center text-white md:p-12">
        <h2 class="text-2xl font-bold md:text-3xl">See it working for your business</h2>
        <p class="mt-2 text-blue-100">Set up in about five minutes. Cancel any time.</p>
        <div class="mt-6 flex flex-col justify-center gap-3 sm:flex-row">
          <a href="/signup" class="inline-flex min-h-12 items-center justify-center rounded-xl bg-white px-6 font-semibold text-brand-700">Get started</a>
          <a href="/pricing" class="inline-flex min-h-12 items-center justify-center rounded-xl border border-white/40 px-6 font-semibold text-white">See pricing</a>
        </div>
      </div>
    </section>
  </main>
  <SiteFooter />
</BaseLayout>
