---
export const prerender = true;
import BaseLayout from '../layouts/BaseLayout.astro';
import AuthForm from '../components/islands/AuthForm';
---
<BaseLayout title="Create account">
  <main class="min-h-dvh grid place-items-center px-4 py-10">
    <div class="w-full max-w-sm">
      <a href="/" class="block text-center text-2xl font-bold text-brand-600">Doddo</a>
      <div class="mt-6 rounded-2xl bg-white p-6 shadow-sm ring-1 ring-slate-200">
        <h1 class="text-xl font-semibold">Create your account</h1>
        <p class="mt-1 text-sm text-slate-500">Free to start. Set up your business in about 5 minutes.</p>
        <div class="mt-5"><AuthForm mode="signup" next="/onboarding" client:load /></div>
        <p class="mt-6 text-center text-sm text-slate-600">Already have an account? <a class="font-medium text-brand-700 hover:underline" href="/login">Sign in</a></p>
      </div>
    </div>
  </main>
</BaseLayout>
