---
import BaseLayout from '../layouts/BaseLayout.astro';
import AuthShell from '../components/astro/AuthShell.astro';
import AuthForm from '../components/islands/AuthForm';
export const prerender = true;
---
<BaseLayout title="Create your account" description="Create a Doddo account to take online bookings for your business, or to manage your own appointments." canonical="/signup">
  <AuthShell title="Create your account" subtitle="Takes about five minutes. £5 a month, no contract.">
    <AuthForm mode="signup" next="/onboarding" client:load />
    <Fragment slot="footer">Already have an account? <a class="font-semibold text-brand-700 hover:underline" href="/login">Sign in</a></Fragment>
  </AuthShell>
</BaseLayout>
