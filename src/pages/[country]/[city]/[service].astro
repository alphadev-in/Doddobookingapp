---
import Logo from '../../../components/astro/Logo.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SiteFooter from '../../../components/astro/SiteFooter.astro';
import { COUNTRIES, SERVICES, slugify, countryBySlug, related } from '../../../lib/seo-data';

export const prerender = true;

export function getStaticPaths() {
  return COUNTRIES.flatMap((c) =>
    c.cities.flatMap((city) => SERVICES.map((service) => ({
      params: { country: c.code, city: slugify(city), service: service.slug },
      props: { countryName: c.name, cityName: city, service },
    }))),
  );
}

const { countryName, cityName, service } = Astro.props;
const { country, city } = Astro.params;
const label = `${service.name} booking in ${cityName}`;
const title = `Online booking for ${service.plural} in ${cityName}`;
const description = `Book ${service.plural} in ${cityName}, ${countryName}. Doddo gives ${service.plural} an online booking page, a team calendar, deposits and reminders for £5 a month.`;
const rel = related(country!, city!, service.slug);
const jsonLd = [
  { '@context': 'https://schema.org', '@type': 'Service', name: label, serviceType: service.name, description: service.blurb,
    areaServed: { '@type': 'City', name: cityName, containedInPlace: { '@type': 'Country', name: countryName } },
    provider: { '@type': 'Organization', name: 'Doddo', url: 'https://doddo.co.uk/' } },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Doddo', item: 'https://doddo.co.uk/' },
    { '@type': 'ListItem', position: 2, name: 'Locations', item: 'https://doddo.co.uk/locations' },
    { '@type': 'ListItem', position: 3, name: countryName, item: `https://doddo.co.uk/locations#${country}` },
    { '@type': 'ListItem', position: 4, name: cityName, item: `https://doddo.co.uk/${country}/${city}/${service.slug}` },
  ] },
];
const countryObj = countryBySlug(country!);
---
<BaseLayout title={title} description={description} canonical={`/${country}/${city}/${service.slug}`} jsonLd={jsonLd}>
  <header class="border-b border-slate-200 bg-white/85 backdrop-blur">
    <nav class="mx-auto flex max-w-5xl items-center justify-between px-4 py-3" aria-label="Main">
      <Logo />
      <div class="flex items-center gap-2">
        <a href="/signup" class="inline-flex min-h-11 items-center rounded-lg bg-brand-600 px-4 text-sm font-semibold text-white hover:bg-brand-700">Start your business</a>
      </div>
    </nav>
  </header>
  <main id="main" class="mx-auto max-w-5xl px-4 py-10 md:py-14">
    <nav aria-label="Breadcrumb" class="text-sm text-slate-500">
      <ol class="flex flex-wrap items-center gap-1">
        <li><a href="/" class="hover:text-slate-900">Doddo</a> <span aria-hidden="true">/</span></li>
        <li><a href="/locations" class="hover:text-slate-900">Locations</a> <span aria-hidden="true">/</span></li>
        <li><a href="/locations" class="hover:text-slate-900">{countryObj?.name}</a> <span aria-hidden="true">/</span></li>
        <li aria-current="page" class="text-slate-700">{cityName}</li>
      </ol>
    </nav>

    <section class="mt-6 grid items-center gap-10 md:grid-cols-2">
      <div class="anim-fade-up">
        <p class="text-sm font-semibold uppercase tracking-wider text-brand-600">{cityName}, {countryName}</p>
        <h1 class="mt-3 text-4xl font-extrabold tracking-tight md:text-5xl">{service.name} booking in {cityName}</h1>
        <p class="mt-4 text-lg leading-relaxed text-slate-600">{service.blurb}</p>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <a href="/signup" class="inline-flex min-h-12 items-center justify-center rounded-xl bg-brand-600 px-6 font-semibold text-white shadow-lg shadow-brand-600/30 hover:-translate-y-0.5 hover:bg-brand-700">Set up your {service.name.toLowerCase()} booking page</a>
          <a href="/pricing" class="inline-flex min-h-12 items-center justify-center rounded-xl border border-slate-300 bg-white px-6 font-semibold hover:bg-slate-50">See pricing: £5 a month</a>
        </div>
      </div>
      <div class="anim-fade-up rounded-3xl bg-white p-6 shadow-xl shadow-brand-600/10 ring-1 ring-slate-200" style="animation-delay:.1s">
        <p class="text-sm font-semibold text-slate-500">What {service.plural} in {cityName} get with Doddo</p>
        <ul class="mt-4 space-y-3 text-[15px]">
          {['Online booking page clients can find on Google and social', 'Shared team calendar with a colour for each person', 'Deposits and a clear cancellation policy', 'Email and SMS reminders that cut missed appointments', 'Client records with private notes', 'Unlimited bookings and team members for one location'].map((x) => (
            <li class="flex gap-3"><span aria-hidden="true" class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-emerald-100 text-xs font-bold text-emerald-700">✓</span>{x}</li>
          ))}
        </ul>
      </div>
    </section>

    <section class="mt-16 grid gap-8 md:grid-cols-2" aria-labelledby="how">
      <div>
        <h2 id="how" class="text-2xl font-bold tracking-tight">How it works for {service.plural} in {cityName}</h2>
        <ol class="mt-5 space-y-4 text-slate-700">
          <li><strong>1. Set your services and hours.</strong> Add each {service.name.toLowerCase()} service with its length and price, plus the hours you work.</li>
          <li><strong>2. Share your booking link.</strong> Put it on your website, Google Business Profile and social pages. Clients in {cityName} can book at any hour.</li>
          <li><strong>3. Manage it from your phone.</strong> See the day or week, move appointments, and send reminders without phone tag.</li>
        </ol>
      </div>
      <div class="rounded-2xl bg-slate-50 p-6 ring-1 ring-slate-200">
        <h2 class="text-lg font-semibold">Good to know</h2>
        <p class="mt-3 text-slate-600">Doddo is built for independent {service.plural} and small teams. Turn deposits on or off, pick your own time-slot length, and import your service list from a spreadsheet. The app also installs on your phone home screen.</p>
        <p class="mt-3 text-slate-600">Pricing is £5 a month with no contract. Cancel any time.</p>
      </div>
    </section>

    <section class="mt-16" aria-labelledby="more">
      <h2 id="more" class="text-xl font-bold">Other services in {cityName}</h2>
      <ul class="mt-4 flex flex-wrap gap-2">
        {rel.services.map((s) => <li><a class="inline-flex min-h-11 items-center rounded-full border border-slate-300 bg-white px-4 text-sm font-medium hover:border-brand-500 hover:text-brand-700" href={`/${country}/${city}/${s.slug}`}>{s.name} in {cityName}</a></li>)}
      </ul>
      <h2 class="mt-8 text-xl font-bold">{service.name} booking in other {countryName} cities</h2>
      <ul class="mt-4 flex flex-wrap gap-2">
        {rel.cities.map((c) => <li><a class="inline-flex min-h-11 items-center rounded-full border border-slate-300 bg-white px-4 text-sm font-medium hover:border-brand-500 hover:text-brand-700" href={`/${country}/${slugify(c)}/${service.slug}`}>{c}</a></li>)}
      </ul>
    </section>

    <section class="mt-16 rounded-3xl bg-gradient-to-br from-brand-600 to-blue-800 p-8 text-white md:p-12">
      <h2 class="text-2xl font-bold md:text-3xl">Start taking {cityName} bookings online</h2>
      <p class="mt-2 max-w-2xl text-blue-100">Create your business account in about five minutes.</p>
      <a href="/signup" class="mt-6 inline-flex min-h-12 items-center rounded-xl bg-white px-6 font-semibold text-brand-700 hover:-translate-y-0.5">Create business account</a>
    </section>
  </main>
  <SiteFooter />
</BaseLayout>
