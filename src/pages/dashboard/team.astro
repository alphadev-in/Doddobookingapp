---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import TeamManager from '../../components/islands/TeamManager';
import { loadOwnerBusiness } from '../../lib/page-auth';
export const prerender = false;

const ctx = await loadOwnerBusiness(Astro);
if ('redirect' in ctx) return Astro.redirect(ctx.redirect);
const { business, unread, isAdmin, isSubscribed } = ctx;
---
<DashboardLayout title="Team" active="team" businessName={business.name} bookingSlug={business.slug} unread={unread} isAdmin={isAdmin} showSubscribeModal={!isSubscribed}>
  <TeamManager client:load />
</DashboardLayout>
