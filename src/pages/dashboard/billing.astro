---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import BillingActions from '../../components/islands/BillingActions';
import { loadOwnerBusiness } from '../../lib/page-auth';
export const prerender = false;

const ctx = await loadOwnerBusiness(Astro);
if ('redirect' in ctx) return Astro.redirect(ctx.redirect);
const { business, unread, isAdmin } = ctx;
const sub = business.subscription;
const isActive = sub.status === 'active' || sub.status === 'trialing';
const status = Astro.url.searchParams.get('status');
const labels: Record<string, string> = { trialing: 'Trial', active: 'Active', paused: 'Payment problem', cancelled: 'Cancelled' };
const welcome = Astro.url.searchParams.has('welcome');
const periodEnd = sub.currentPeriodEnd ? new Date(sub.currentPeriodEnd).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' }) : null;
---
<DashboardLayout title="Subscription" active="settings" businessName={business.name} bookingSlug={business.slug} unread={unread} isAdmin={isAdmin}>
  <div class="mx-auto max-w-2xl space-y-6">
    {welcome && <div class="rounded-2xl bg-blue-50 p-4 text-sm text-blue-900 ring-1 ring-blue-200"><p class="font-semibold">Your business is set up.</p><p class="mt-1">Subscribe to keep your booking page live for clients.</p></div>}
    {status === 'success' && <div class="rounded-2xl bg-emerald-50 p-4 text-sm font-medium text-emerald-800 ring-1 ring-emerald-200">Thank you. Your subscription is being activated.</div>}
    {status === 'cancelled' && <div class="rounded-2xl bg-amber-50 p-4 text-sm text-amber-900 ring-1 ring-amber-200">Checkout was cancelled. You have not been charged.</div>}

    <section class="rounded-3xl bg-white p-6 shadow-sm ring-1 ring-slate-200 md:p-8">
      <p class="text-sm font-semibold uppercase tracking-wider text-slate-500">Your plan</p>
      <div class="mt-2 flex flex-wrap items-end justify-between gap-4">
        <div>
          <p class="text-3xl font-extrabold tracking-tight">Doddo <span class="text-brand-600">£5</span><span class="text-base font-normal text-slate-500"> / month</span></p>
          <p class="mt-1 text-sm text-slate-600">No contract. Cancel any time.</p>
        </div>
        <span class:list={['rounded-full px-3 py-1 text-sm font-semibold', isActive ? 'bg-emerald-100 text-emerald-800' : 'bg-slate-100 text-slate-700']}>{labels[sub.status] ?? sub.status}</span>
      </div>
      {periodEnd && <p class="mt-4 text-sm text-slate-600">Current period ends {periodEnd}.</p>}
      <div class="mt-6">
        <BillingActions canManage={!!sub.stripeCustomerId} isActive={isActive} client:load />
      </div>
    </section>

    <section class="rounded-2xl bg-white p-5 text-sm ring-1 ring-slate-200">
      <p class="font-semibold">What's included</p>
      <ul class="mt-3 grid gap-2 sm:grid-cols-2">
        {['Unlimited bookings', 'Unlimited team members (one location)', 'Online booking page', 'Calendar and client records', 'Email, SMS and phone alerts', 'Deposits (optional)'].map((x) => <li class="flex gap-2"><span class="text-emerald-600" aria-hidden="true">✓</span>{x}</li>)}
      </ul>
    </section>
  </div>
</DashboardLayout>
