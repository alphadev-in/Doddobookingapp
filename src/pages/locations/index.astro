---
import Logo from '../../components/astro/Logo.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteFooter from '../../components/astro/SiteFooter.astro';
import { COUNTRIES, SERVICES, slugify } from '../../lib/seo-data';
export const prerender = true;
---
<BaseLayout title="Locations: online booking by city" description="Find online booking for barbers, salons, clinics and studios in cities across the UK, US, Canada, Australia and Ireland." canonical="/locations">
  <header class="border-b border-slate-200 bg-white/85 backdrop-blur">
    <nav class="mx-auto flex max-w-5xl items-center justify-between px-4 py-3" aria-label="Main">
      <Logo />
      <a href="/signup" class="inline-flex min-h-11 items-center rounded-lg bg-brand-600 px-4 text-sm font-semibold text-white hover:bg-brand-700">Start your business</a>
    </nav>
  </header>
  <main id="main" class="mx-auto max-w-5xl px-4 py-12">
    <h1 class="text-4xl font-extrabold tracking-tight">Online booking by city</h1>
    <p class="mt-3 max-w-2xl text-lg text-slate-600">Choose your city to see booking options for barbers, salons, clinics, studios and more.</p>
    <div class="mt-10 space-y-12">
      {COUNTRIES.map((c) => (
        <section id={c.code} aria-labelledby={`c-${c.code}`}>
          <h2 id={`c-${c.code}`} class="text-2xl font-bold">{c.name}</h2>
          <ul class="mt-4 grid grid-cols-2 gap-2 sm:grid-cols-3 md:grid-cols-4">
            {c.cities.map((city) => (
              <li><a class="flex min-h-11 items-center rounded-lg px-2 text-sm text-brand-700 hover:bg-brand-50 hover:underline" href={`/${c.code}/${slugify(city)}/${SERVICES[0].slug}`}>{city}</a></li>
            ))}
          </ul>
        </section>
      ))}
    </div>
  </main>
  <SiteFooter />
</BaseLayout>
