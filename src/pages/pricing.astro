---
import Logo from '../components/astro/Logo.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteFooter from '../components/astro/SiteFooter.astro';
export const prerender = true;

const perks = [
  'Unlimited bookings',
  'Unlimited team members for one location',
  'Online booking page & shareable link',
  'Day and week team calendar',
  'Walk-ins, phone bookings and time blocks',
  'Client records with private notes',
  'Deposits per service (optional)',
  'Turn payment on or off',
  'Email and SMS reminders',
  'In-app notifications',
  'Import and export your services (CSV)',
  'Categories for services',
  'Install on your phone like an app',
  'Help centre and FAQ',
];
const faqs = [
  { q: 'Is there a contract?', a: 'No. You pay £5 a month and can cancel any time. No set-up fees.' },
  { q: 'Is there a limit on bookings or team members?', a: 'No. Bookings are unlimited, and you can add unlimited team members for one location.' },
  { q: 'Do my clients pay a fee?', a: 'No. Clients book for free. Any deposit you take goes straight to you.' },
];
const jsonLd = {
  '@context': 'https://schema.org', '@type': 'Product', name: 'Doddo',
  description: 'Online booking, calendar and deposits for appointment businesses.',
  offers: { '@type': 'Offer', price: '5.00', priceCurrency: 'GBP', availability: 'https://schema.org/InStock', url: 'https://doddo.co.uk/pricing',
    priceSpecification: { '@type': 'UnitPriceSpecification', price: '5.00', priceCurrency: 'GBP', billingDuration: 'P1M' } },
};
---
<BaseLayout title="Pricing: £5 a month, no contract" description="Doddo costs £5 a month with no contract. Online booking, team calendar, deposits and reminders included." canonical="/pricing" jsonLd={jsonLd}>
  <header class="border-b border-slate-200 bg-white/80 backdrop-blur">
    <nav class="mx-auto flex max-w-6xl items-center justify-between px-4 py-3" aria-label="Main">
      <Logo />
      <div class="flex items-center gap-2">
        <a href="/login" class="inline-flex min-h-11 items-center rounded-lg px-3 text-sm font-medium text-slate-700 hover:bg-slate-100">Sign in</a>
        <a href="/signup" class="inline-flex min-h-11 items-center rounded-lg bg-brand-600 px-4 text-sm font-semibold text-white hover:bg-brand-700">Get started</a>
      </div>
    </nav>
  </header>
  <main id="main">
    <section class="px-4 pt-16 pb-10 text-center">
      <p class="anim-fade-up text-sm font-semibold uppercase tracking-wider text-brand-600">Pricing</p>
      <h1 class="anim-fade-up mt-3 text-4xl font-extrabold tracking-tight md:text-5xl" style="animation-delay:.05s">One simple price</h1>
      <p class="anim-fade-up mx-auto mt-4 max-w-xl text-lg text-slate-600" style="animation-delay:.1s">Everything included. No contract. Cancel any time.</p>
    </section>

    <section class="px-4 pb-20" aria-label="Plan">
      <article class="anim-fade-up relative mx-auto max-w-md overflow-hidden rounded-3xl bg-white p-8 shadow-2xl shadow-brand-600/15 ring-1 ring-slate-200" style="animation-delay:.15s">
        <div class="absolute inset-x-0 top-0 h-1.5 bg-gradient-to-r from-brand-600 to-violet-600"></div>
        <p class="text-sm font-semibold text-slate-500">Doddo</p>
        <p class="mt-2 flex items-end gap-1"><span class="text-6xl font-extrabold tracking-tight">£5</span><span class="pb-2 text-slate-500">/ month</span></p>
        <p class="mt-2 text-sm text-slate-600">No contract. Cancel any time.</p>
        <ul class="mt-8 space-y-3">
          {perks.map((p) => <li class="flex items-start gap-3 text-[15px]"><span aria-hidden="true" class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-emerald-100 text-xs font-bold text-emerald-700">✓</span>{p}</li>)}
        </ul>
        <a href="/signup" class="mt-8 flex min-h-14 items-center justify-center rounded-xl bg-brand-600 text-base font-semibold text-white shadow-lg shadow-brand-600/30 hover:-translate-y-0.5 hover:bg-brand-700">Get started</a>
        <p class="mt-3 text-center text-xs text-slate-500">Payment details are taken securely at sign-up.</p>
      </article>
    </section>

    <section class="bg-white px-4 py-16" aria-labelledby="pfaq">
      <div class="mx-auto max-w-2xl">
        <h2 id="pfaq" class="text-center text-2xl font-bold tracking-tight md:text-3xl">Pricing questions</h2>
        <div class="mt-8 divide-y divide-slate-200">
          {faqs.map((f) => (
            <details class="group py-4">
              <summary class="flex min-h-11 cursor-pointer list-none items-center justify-between gap-4 font-semibold">{f.q}<span aria-hidden="true" class="text-2xl leading-none text-brand-600 transition group-open:rotate-45">+</span></summary>
              <p class="mt-2 text-slate-600">{f.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>
  </main>
  <SiteFooter />
</BaseLayout>
