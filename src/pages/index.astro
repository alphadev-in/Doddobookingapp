---
// Static marketing page: zero client JS.
import BaseLayout from '../layouts/BaseLayout.astro';
export const prerender = true;
const features = [
  { title: 'Online booking link', body: 'Clients book 24/7 from one link you can share anywhere: Instagram, Google, your website.' },
  { title: 'Multi-staff calendar', body: 'Day and week views with a column per team member. Walk-ins, blocks and reschedules in a tap.' },
  { title: 'Automated reminders', body: 'Confirmations, 24-hour reminders and cancellation notices by email and SMS.' },
  { title: 'Deposits & no-show protection', body: 'Take a deposit per service and set a clear cancellation window that you control.' },
];
---
<BaseLayout title="Online booking, calendar & deposits" description="Doddo: online booking, a multi-staff calendar, client CRM and deposit protection for appointment businesses.">
  <header class="border-b border-slate-200 bg-white">
    <nav class="mx-auto flex max-w-6xl items-center justify-between px-4 py-4" aria-label="Main">
      <a href="/" class="text-xl font-bold text-brand-600">Doddo</a>
      <div class="flex items-center gap-2">
        <a href="/login" class="min-h-11 inline-flex items-center rounded-lg px-3 text-sm font-medium text-slate-700 hover:bg-slate-100">Sign in</a>
        <a href="/signup" class="min-h-11 inline-flex items-center rounded-lg bg-brand-600 px-4 text-sm font-semibold text-white hover:bg-brand-700">Start free</a>
      </div>
    </nav>
  </header>

  <main>
    <section class="mx-auto max-w-6xl px-4 py-16 md:py-24">
      <p class="text-sm font-semibold uppercase tracking-wide text-brand-600">Booking, calendar & CRM</p>
      <h1 class="mt-3 max-w-3xl text-4xl font-bold tracking-tight md:text-6xl">Fill your calendar. Protect your time.</h1>
      <p class="mt-5 max-w-2xl text-lg text-slate-600">Doddo gives salons, barbers and studios an online booking page, a shared team calendar and deposits that cut no-shows.</p>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <a href="/signup" class="min-h-12 inline-flex items-center justify-center rounded-lg bg-brand-600 px-6 py-3 font-semibold text-white hover:bg-brand-700">Set up my business</a>
        <a href="/book/demo-studio" class="min-h-12 inline-flex items-center justify-center rounded-lg border border-slate-300 bg-white px-6 py-3 font-semibold text-slate-800 hover:bg-slate-50">Preview a live booking page</a>
      </div>
    </section>

    <section class="bg-white py-16" aria-labelledby="value">
      <div class="mx-auto max-w-6xl px-4">
        <h2 id="value" class="text-2xl font-bold md:text-3xl">Everything you need for Phase 1</h2>
        <ul class="mt-10 grid gap-6 sm:grid-cols-2">
          {features.map((f) => (
            <li class="rounded-2xl border border-slate-200 p-6">
              <h3 class="text-lg font-semibold">{f.title}</h3>
              <p class="mt-2 text-slate-600">{f.body}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="py-16" aria-labelledby="pricing">
      <div class="mx-auto max-w-6xl px-4">
        <h2 id="pricing" class="text-2xl font-bold md:text-3xl">Simple pricing</h2>
        <p class="mt-2 text-sm text-slate-500">Preview only. Final prices are set before launch.</p>
        <div class="mt-8 grid gap-6 md:grid-cols-2">
          <div class="rounded-2xl bg-white p-6 ring-1 ring-slate-200">
            <p class="font-semibold">Solo</p>
            <p class="mt-2 text-3xl font-bold">£15<span class="text-base font-normal text-slate-500">/mo</span></p>
            <ul class="mt-4 space-y-2 text-sm text-slate-600"><li>1 team member</li><li>Online booking & calendar</li><li>Deposits & client CRM</li></ul>
          </div>
          <div class="rounded-2xl bg-white p-6 ring-2 ring-brand-600">
            <p class="font-semibold">Team</p>
            <p class="mt-2 text-3xl font-bold">£35<span class="text-base font-normal text-slate-500">/mo</span></p>
            <ul class="mt-4 space-y-2 text-sm text-slate-600"><li>Up to 10 team members</li><li>Multi-staff calendar</li><li>Automated email & SMS reminders</li></ul>
          </div>
        </div>
      </div>
    </section>

    <section class="bg-brand-600 py-14 text-white">
      <div class="mx-auto flex max-w-6xl flex-col items-start gap-4 px-4 md:flex-row md:items-center md:justify-between">
        <h2 class="text-2xl font-bold">Ready to take bookings online?</h2>
        <a href="/signup" class="min-h-12 inline-flex items-center rounded-lg bg-white px-6 py-3 font-semibold text-brand-700">Create your account</a>
      </div>
    </section>
  </main>
  <footer class="py-8 text-center text-sm text-slate-500">© Doddo</footer>
</BaseLayout>
