---
// Static marketing page: zero client JS, fully prerendered, indexed in the sitemap.
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteFooter from '../components/astro/SiteFooter.astro';
export const prerender = true;

const features = [
  { title: 'Online booking link', body: 'Clients book 24/7 from one link you can share on Instagram, Google and your website.', icon: 'M4 4h16v16H4zM4 9h16M9 14h2m2 0h2' },
  { title: 'Multi-staff calendar', body: 'Day and week views with a column per team member. Walk-ins, blocks and reschedules in a tap.', icon: 'M3 5h18v16H3zM3 10h18M8 3v4M16 3v4' },
  { title: 'Automated reminders', body: 'Confirmations, 24-hour reminders and cancellation notices by email and SMS.', icon: 'M12 22a2 2 0 002-2h-4a2 2 0 002 2zM18 16v-5a6 6 0 10-12 0v5l-2 2h16z' },
  { title: 'Deposits & no-show protection', body: 'Take a deposit per service and set a cancellation window you control.', icon: 'M12 1v22M17 5H9.5a3.5 3.5 0 000 7h5a3.5 3.5 0 010 7H6' },
];
const steps = [
  { n: '1', title: 'Set up in minutes', body: 'Add your hours, services and team. Your booking link is ready straight away.' },
  { n: '2', title: 'Share your link', body: 'Post it on social, Google Business and your website. Clients pick a time that suits them.' },
  { n: '3', title: 'Run your day', body: 'Manage everything from the calendar on your phone. Reminders go out automatically.' },
];
const faqs = [
  { q: 'Do I need a website to take bookings?', a: 'No. Every business gets its own booking link that works on any phone or laptop. Share it anywhere.' },
  { q: 'How do deposits work?', a: 'Set a deposit per service as a percentage or fixed amount. Clients pay it when they book, and you choose whether late cancellations keep it.' },
  { q: 'Can several team members share one calendar?', a: 'Yes. Each team member has their own colour, hours and services, and the calendar shows everyone side by side.' },
  { q: 'Is my client data safe?', a: 'Client data is private to your business and stored securely. Team notes are visible only to your team.' },
];
const siteUrl = 'https://doddo.co.uk/';
const jsonLd = [
  { '@context': 'https://schema.org', '@type': 'SoftwareApplication', name: 'Doddo', applicationCategory: 'BusinessApplication', operatingSystem: 'Web', url: siteUrl,
    description: 'Online booking, a multi-staff calendar, client CRM and deposit protection for appointment businesses.',
    offers: { '@type': 'Offer', name: 'Doddo', price: '5.00', priceCurrency: 'GBP' } },
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
  { '@context': 'https://schema.org', '@type': 'Organization', name: 'Doddo', legalName: 'Aelius Venture Limited', url: siteUrl, logo: 'https://doddo.co.uk/favicon.svg' },
];
---
<BaseLayout title="Online booking, calendar & deposits for salons and studios" canonical="/" jsonLd={jsonLd}>
  <header class="sticky top-0 z-40 border-b border-slate-200/70 bg-white/80 backdrop-blur-md">
    <nav class="mx-auto flex max-w-6xl items-center justify-between px-4 py-3" aria-label="Main">
      <a href="/" class="text-xl font-extrabold tracking-tight text-brand-600">Doddo</a>
      <div class="flex items-center gap-1 sm:gap-2">
        <a href="#features" class="hidden min-h-11 items-center rounded-lg px-3 text-sm font-medium text-slate-600 hover:text-slate-900 md:inline-flex">Features</a>
        <a href="#pricing" class="hidden min-h-11 items-center rounded-lg px-3 text-sm font-medium text-slate-600 hover:text-slate-900 md:inline-flex">Pricing</a>
        <a href="/login" class="inline-flex min-h-11 items-center rounded-lg px-3 text-sm font-medium text-slate-700 hover:bg-slate-100">Sign in</a>
        <a href="/signup" class="inline-flex min-h-11 items-center rounded-lg bg-brand-600 px-4 text-sm font-semibold text-white shadow-sm shadow-brand-600/30 hover:bg-brand-700">Get started</a>
      </div>
    </nav>
  </header>

  <main id="main">
    <!-- Hero -->
    <section class="relative overflow-hidden">
      <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10">
        <div class="anim-blob absolute -top-24 -left-20 h-96 w-96 rounded-full bg-brand-500/20 blur-3xl"></div>
        <div class="anim-blob absolute top-40 -right-24 h-96 w-96 rounded-full bg-violet-500/20 blur-3xl" style="animation-delay:-5s"></div>
      </div>
      <div class="mx-auto grid max-w-6xl items-center gap-12 px-4 pt-14 pb-20 md:grid-cols-2 md:pt-24">
        <div>
          <h1 class="anim-fade-up mt-5 text-4xl font-extrabold tracking-tight text-slate-900 sm:text-5xl lg:text-6xl" style="animation-delay:.05s">
            Fill your calendar. <span class="bg-gradient-to-r from-brand-600 to-violet-600 bg-clip-text text-transparent">Protect your time.</span>
          </h1>
          <p class="anim-fade-up mt-5 max-w-xl text-lg leading-relaxed text-slate-600" style="animation-delay:.12s">
            Online booking, a shared team calendar and deposits that cut no-shows. Everything you need to run appointments, in one app.
          </p>
          <div class="anim-fade-up mt-8 flex flex-col gap-3 sm:flex-row" style="animation-delay:.2s">
            <a href="/signup" class="inline-flex min-h-12 items-center justify-center rounded-xl bg-brand-600 px-6 py-3 font-semibold text-white shadow-lg shadow-brand-600/30 hover:-translate-y-0.5 hover:bg-brand-700">Set up my business</a>
            <a href="#features" class="inline-flex min-h-12 items-center justify-center rounded-xl border border-slate-300 bg-white px-6 py-3 font-semibold text-slate-800 hover:bg-slate-50">See how it works</a>
          </div>
          <p class="anim-fade-up mt-4 text-sm text-slate-500" style="animation-delay:.25s">Free to start. No card needed.</p>
        </div>

        <!-- Calendar mock -->
        <div class="anim-fade-up relative mx-auto w-full max-w-md" style="animation-delay:.15s" aria-hidden="true">
          <div class="anim-float rounded-2xl bg-white p-4 shadow-2xl shadow-slate-900/10 ring-1 ring-slate-200">
            <div class="mb-3 flex items-center justify-between">
              <p class="text-sm font-semibold">Today</p>
              <span class="rounded-full bg-emerald-100 px-2 py-0.5 text-xs font-medium text-emerald-700">3 booked</span>
            </div>
            <div class="grid grid-cols-[3rem_1fr_1fr] gap-2 text-[11px]">
              <div></div><div class="font-semibold text-slate-600">Ava</div><div class="font-semibold text-slate-600">Ben</div>
              <div class="pt-2 text-slate-400">10:00</div>
              <div class="rounded-lg border-l-4 border-indigo-500 bg-indigo-50 p-2"><p class="font-semibold text-indigo-900">Sophie H.</p><p class="text-indigo-700">Full Colour</p><span class="mt-1 inline-block rounded bg-sky-100 px-1 text-[10px] text-sky-800">Deposit paid</span></div>
              <div class="rounded-lg border-l-4 border-emerald-500 bg-emerald-50 p-2"><p class="font-semibold text-emerald-900">Tom R.</p><p class="text-emerald-700">Haircut</p></div>
              <div class="pt-2 text-slate-400">11:00</div>
              <div class="rounded-lg bg-slate-50 p-2 text-slate-400">Free</div>
              <div class="rounded-lg border-l-4 border-emerald-500 bg-emerald-50 p-2"><p class="font-semibold text-emerald-900">Walk-in</p><p class="text-emerald-700">Beard trim</p></div>
              <div class="pt-2 text-slate-400">12:00</div>
              <div class="rounded-lg bg-stripes p-2 text-[10px] text-slate-500">Lunch</div>
              <div class="rounded-lg bg-slate-50 p-2 text-slate-400">Free</div>
            </div>
          </div>
          <div class="anim-float absolute -bottom-6 -left-4 hidden rounded-xl bg-white px-4 py-3 text-sm shadow-xl ring-1 ring-slate-200 sm:block" style="animation-delay:-2s">
            <p class="font-semibold text-slate-900">New booking</p>
            <p class="text-slate-500">Deposit £17 received</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Trust strip -->
    <section class="border-y border-slate-200 bg-white py-6" aria-label="Highlights">
      <ul class="mx-auto grid max-w-6xl grid-cols-2 gap-4 px-4 text-center md:grid-cols-4">
        {[['24/7', 'online booking'], ['0', 'phone tag'], ['Deposit', 'per service'], ['SMS & email', 'reminders']].map(([a, b]) => (
          <li class="reveal"><p class="text-xl font-bold text-slate-900">{a}</p><p class="text-sm text-slate-500">{b}</p></li>
        ))}
      </ul>
    </section>

    <!-- Features -->
    <section id="features" class="scroll-mt-20 py-20" aria-labelledby="features-title">
      <div class="mx-auto max-w-6xl px-4">
        <div class="reveal mx-auto max-w-2xl text-center">
          <p class="text-sm font-semibold uppercase tracking-wider text-brand-600">Features</p>
          <h2 id="features-title" class="mt-2 text-3xl font-bold tracking-tight md:text-4xl">Everything your front desk does, automated</h2>
          <p class="mt-3 text-slate-600">Stop juggling texts and paper diaries. Doddo runs bookings, reminders and payments for you.</p>
        </div>
        <ul class="mt-12 grid gap-5 sm:grid-cols-2">
          {features.map((f, i) => (
            <li class="reveal group rounded-2xl border border-slate-200 bg-white p-6 transition hover:-translate-y-1 hover:border-brand-300 hover:shadow-xl hover:shadow-brand-600/10" style={`transition-delay:${i * 60}ms`}>
              <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-brand-50 text-brand-600 transition group-hover:bg-brand-600 group-hover:text-white">
                <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d={f.icon} /></svg>
              </span>
              <h3 class="mt-4 text-lg font-semibold">{f.title}</h3>
              <p class="mt-2 text-slate-600">{f.body}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- How it works -->
    <section class="bg-slate-900 py-20 text-white" aria-labelledby="how-title">
      <div class="mx-auto max-w-6xl px-4">
        <h2 id="how-title" class="reveal text-center text-3xl font-bold tracking-tight md:text-4xl">Live in an afternoon</h2>
        <ol class="mt-12 grid gap-8 md:grid-cols-3">
          {steps.map((s, i) => (
            <li class="reveal rounded-2xl bg-white/5 p-6 ring-1 ring-white/10" style={`transition-delay:${i * 100}ms`}>
              <span class="flex h-10 w-10 items-center justify-center rounded-full bg-brand-500 font-bold">{s.n}</span>
              <h3 class="mt-4 text-lg font-semibold">{s.title}</h3>
              <p class="mt-2 text-slate-300">{s.body}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- Pricing -->
    <section id="pricing" class="scroll-mt-20 py-20" aria-labelledby="pricing-title">
      <div class="mx-auto max-w-6xl px-4">
        <div class="reveal mx-auto max-w-2xl text-center">
          <h2 id="pricing-title" class="text-3xl font-bold tracking-tight md:text-4xl">One simple price</h2>
          <p class="mt-3 text-slate-600">£5 a month. No contract. Everything included.</p>
        </div>
        <div class="reveal mx-auto mt-10 max-w-md rounded-3xl bg-white p-8 text-center shadow-xl shadow-brand-600/10 ring-1 ring-slate-200">
          <p class="text-6xl font-extrabold tracking-tight">£5<span class="text-base font-normal text-slate-500"> / month</span></p>
          <p class="mt-2 text-sm text-slate-600">No contract. Cancel any time.</p>
          <a href="/signup" class="mt-6 flex min-h-12 items-center justify-center rounded-xl bg-brand-600 font-semibold text-white hover:bg-brand-700">Get started</a>
          <a href="/pricing" class="mt-3 inline-flex min-h-11 items-center justify-center text-sm font-semibold text-brand-700 hover:underline">See full pricing details →</a>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section id="faq" class="scroll-mt-20 bg-white py-20" aria-labelledby="faq-title">
      <div class="mx-auto max-w-3xl px-4">
        <h2 id="faq-title" class="reveal text-center text-3xl font-bold tracking-tight md:text-4xl">Questions, answered</h2>
        <div class="mt-10 divide-y divide-slate-200">
          {faqs.map((f) => (
            <details class="group py-5">
              <summary class="flex min-h-11 cursor-pointer list-none items-center justify-between gap-4 font-semibold">
                {f.q}
                <span class="text-brand-600 transition group-open:rotate-45 text-2xl leading-none" aria-hidden="true">+</span>
              </summary>
              <p class="mt-3 text-slate-600">{f.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- Final CTA -->
    <section class="px-4 py-16">
      <div class="reveal mx-auto flex max-w-6xl flex-col items-start gap-6 overflow-hidden rounded-3xl bg-gradient-to-br from-brand-600 to-violet-700 p-8 text-white shadow-2xl shadow-brand-600/30 md:flex-row md:items-center md:justify-between md:p-12">
        <div>
          <h2 class="text-2xl font-bold md:text-3xl">Ready to take bookings online?</h2>
          <p class="mt-2 text-indigo-100">Set up your business in about five minutes.</p>
        </div>
        <a href="/signup" class="inline-flex min-h-12 items-center rounded-xl bg-white px-6 py-3 font-semibold text-brand-700 hover:-translate-y-0.5">Create your account</a>
      </div>
    </section>
  </main>

  <SiteFooter />
</BaseLayout>

<style>
  .bg-stripes { background-image: repeating-linear-gradient(45deg, #f1f5f9, #f1f5f9 6px, #e2e8f0 6px, #e2e8f0 12px); }
</style>
