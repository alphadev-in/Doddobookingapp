---
import BaseLayout from './BaseLayout.astro';
import LogoutButton from '../components/islands/LogoutButton';

interface Props {
  title: string;
  active: 'overview' | 'calendar' | 'services' | 'team' | 'clients' | 'settings' | 'help' | 'notifications';
  businessName: string;
  bookingSlug: string;
  unread?: number;
  isAdmin?: boolean;
  wide?: boolean;
}
const { title, active, businessName, bookingSlug, unread = 0, isAdmin = false, wide = false } = Astro.props;

// Icon paths (24x24 stroke icons).
const ICON = {
  home: 'M3 11l9-8 9 8v9a1 1 0 01-1 1h-5v-6H9v6H4a1 1 0 01-1-1z',
  calendar: 'M4 5h16v15H4zM4 10h16M9 3v4M15 3v4',
  services: 'M4 6h16M4 12h10M4 18h7',
  team: 'M16 11a4 4 0 10-8 0 4 4 0 008 0zM4 21a8 8 0 0116 0',
  clients: 'M12 12a4 4 0 100-8 4 4 0 000 8zM4 21v-1a6 6 0 0112 0v1',
  settings: 'M12 15a3 3 0 100-6 3 3 0 000 6zM19.4 15a1.7 1.7 0 00.3 1.8l.1.1a2 2 0 11-2.8 2.8l-.1-.1a1.7 1.7 0 00-1.8-.3 1.7 1.7 0 00-1 1.5V21a2 2 0 11-4 0v-.1a1.7 1.7 0 00-1.1-1.5 1.7 1.7 0 00-1.8.3l-.1.1a2 2 0 11-2.8-2.8l.1-.1a1.7 1.7 0 00.3-1.8 1.7 1.7 0 00-1.5-1H3a2 2 0 110-4h.1a1.7 1.7 0 001.5-1.1 1.7 1.7 0 00-.3-1.8l-.1-.1a2 2 0 112.8-2.8l.1.1a1.7 1.7 0 001.8.3H9a1.7 1.7 0 001-1.5V3a2 2 0 114 0v.1a1.7 1.7 0 001 1.5 1.7 1.7 0 001.8-.3l.1-.1a2 2 0 112.8 2.8l-.1.1a1.7 1.7 0 00-.3 1.8V9a1.7 1.7 0 001.5 1H21a2 2 0 110 4h-.1a1.7 1.7 0 00-1.5 1z',
  help: 'M12 22a10 10 0 100-20 10 10 0 000 20zM9.1 9a3 3 0 115.8 1c0 2-3 3-3 3M12 17h.01',
  bell: 'M18 16v-5a6 6 0 10-12 0v5l-2 2h16zM10 21a2 2 0 004 0',
  shield: 'M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z',
  card: 'M3 6h18v12H3zM3 10h18M7 15h4',
};

const nav = [
  { key: 'overview', href: '/dashboard', label: 'Home', icon: ICON.home },
  { key: 'calendar', href: '/dashboard/calendar', label: 'Calendar', icon: ICON.calendar },
  { key: 'services', href: '/dashboard/services', label: 'Services', icon: ICON.services },
  { key: 'team', href: '/dashboard/team', label: 'Team', icon: ICON.team },
  { key: 'clients', href: '/dashboard/clients', label: 'Clients', icon: ICON.clients },
  { key: 'settings', href: '/dashboard/settings', label: 'Settings', icon: ICON.settings },
  { key: 'help', href: '/dashboard/help', label: 'Help & FAQ', icon: ICON.help },
];
const linkCls = (on: boolean) =>
  ['group flex min-h-11 items-center gap-3 rounded-xl px-3 text-sm font-medium transition', on ? 'bg-brand-600 text-white shadow-sm shadow-brand-600/30' : 'text-slate-600 hover:bg-slate-100 hover:text-slate-900'].join(' ');
---
<BaseLayout title={title} noindex>
  <div class="min-h-dvh bg-slate-50 md:flex">
    <!-- Desktop sidebar -->
    <aside class="hidden md:fixed md:inset-y-0 md:flex md:w-64 md:flex-col border-r border-slate-200 bg-white p-4">
      <a href="/dashboard" class="flex items-center px-2 py-3" aria-label="Doddo dashboard"><img src="/Doddo.png" alt="Doddo" width="203" height="91" class="h-8 w-auto" /></a>
      <p class="mt-1 truncate px-2 text-xs text-slate-500">{businessName}</p>
      <nav class="mt-6 flex flex-col gap-1" aria-label="Dashboard">
        {nav.map((n) => (
          <a href={n.href} aria-current={active === n.key ? 'page' : undefined} class={linkCls(active === n.key)}>
            <svg class="h-5 w-5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d={n.icon} /></svg>
            {n.label}
          </a>
        ))}
        <a href="/notifications" class={linkCls(active === 'notifications')}>
          <svg class="h-5 w-5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d={ICON.bell} /></svg>
          <span class="flex-1">Notifications</span>
          {unread > 0 && <span class="rounded-full bg-rose-600 px-2 text-xs font-bold text-white">{unread}</span>}
        </a>
        {isAdmin && (
          <a href="/admin" class="mt-2 flex min-h-11 items-center gap-3 rounded-xl px-3 text-sm font-semibold text-rose-700 hover:bg-rose-50">
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d={ICON.shield} /></svg>
            Admin
          </a>
        )}
      </nav>
      <div class="mt-auto space-y-2">
        <a href={`/book/${bookingSlug}`} target="_blank" rel="noopener" class="flex min-h-11 items-center justify-center rounded-xl border border-slate-300 text-sm font-semibold hover:bg-slate-50">View booking page ↗</a>
        <LogoutButton client:load />
      </div>
    </aside>

    <div class="min-w-0 flex-1 md:ml-64">
      <header class="sticky top-0 z-30 flex items-center justify-between gap-3 border-b border-slate-200 bg-white/85 px-4 py-3 backdrop-blur-md">
        <div class="min-w-0">
          <p class="truncate text-xs text-slate-500 md:hidden">{businessName}</p>
          <h1 class="truncate text-lg font-bold">{title}</h1>
        </div>
        <div class="flex items-center gap-2">
          <a href="/notifications" aria-label={`Notifications${unread ? `, ${unread} unread` : ''}`} class="relative inline-flex h-11 w-11 items-center justify-center rounded-xl border border-slate-200 bg-white hover:bg-slate-50 md:hidden">
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d={ICON.bell} /></svg>
            {unread > 0 && <span class="absolute -right-1 -top-1 min-w-5 rounded-full bg-rose-600 px-1 text-center text-[11px] font-bold leading-5 text-white">{unread}</span>}
          </a>
          <a href={`/book/${bookingSlug}`} target="_blank" rel="noopener" class="hidden items-center rounded-xl border border-slate-300 px-3 py-2 text-sm font-semibold hover:bg-slate-50 sm:inline-flex">Booking page ↗</a>
        </div>
      </header>
      <main id="main" class:list={["anim-fade-up mx-auto p-4 pb-28 md:p-8 md:pb-10", wide ? "max-w-none" : "max-w-6xl"]}>
        <slot />
      </main>
    </div>

    <!-- Mobile bottom navigation: five items. Everything else lives under "More". -->
    <nav class="fixed inset-x-2 bottom-[max(0.5rem,env(safe-area-inset-bottom))] z-50 rounded-2xl border border-slate-200 bg-white shadow-xl shadow-slate-900/15 md:hidden" aria-label="Primary" style="touch-action:manipulation">
      <ul class="mx-auto grid max-w-md grid-cols-5 gap-1 p-1.5">
        {[
          { key: 'overview', href: '/dashboard', label: 'Home', icon: ICON.home },
          { key: 'calendar', href: '/dashboard/calendar', label: 'Calendar', icon: ICON.calendar },
          { key: 'services', href: '/dashboard/services', label: 'Services', icon: ICON.services },
          { key: 'clients', href: '/dashboard/clients', label: 'Clients', icon: ICON.clients },
        ].map((n) => (
          <li>
            <a href={n.href} aria-current={active === n.key ? 'page' : undefined}
              class:list={['relative flex min-h-16 flex-col items-center justify-center gap-0.5 rounded-xl text-[11px] font-semibold', active === n.key ? 'text-brand-700' : 'text-slate-500 hover:text-slate-800']}>
              <span class:list={['flex h-9 w-16 items-center justify-center rounded-full', active === n.key ? 'bg-brand-600 text-white shadow-md shadow-brand-600/30' : '']}>
                <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d={n.icon} /></svg>
              </span>
              {n.label}
            </a>
          </li>
        ))}
        <li>
          <button type="button" data-more-open aria-haspopup="dialog" aria-controls="more-sheet"
            class="relative flex min-h-16 w-full flex-col items-center justify-center gap-0.5 rounded-xl text-[11px] font-semibold text-slate-500">
            <span class="flex h-8 w-16 items-center justify-center rounded-full"><svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="5" cy="12" r="1.5" /><circle cx="12" cy="12" r="1.5" /><circle cx="19" cy="12" r="1.5" /></svg></span>
            More
          </button>
        </li>
      </ul>
    </nav>

    <!-- "More" sheet: centred, lightly blurred background -->
    <div id="more-sheet" class="fixed inset-0 z-50 hidden items-center justify-center p-4 md:hidden" role="dialog" aria-modal="true" aria-label="More options">
      <button type="button" data-more-close class="absolute inset-0 bg-slate-900/30 backdrop-blur-sm" aria-label="Close menu"></button>
      <div class="anim-pop relative w-full max-w-sm overflow-hidden rounded-2xl bg-white p-3 shadow-2xl">
        <p class="px-3 pb-2 pt-1 text-xs font-semibold uppercase tracking-wider text-slate-500">More</p>
        <ul class="grid gap-1">
          {[
            { href: '/dashboard/team', label: 'Team', icon: ICON.team, key: 'team' },
            { href: '/notifications', label: 'Notifications', icon: ICON.bell, key: 'notifications', badge: unread },
            { href: '/dashboard/settings', label: 'Settings', icon: ICON.settings, key: 'settings' },
            { href: '/dashboard/billing', label: 'Subscription', icon: ICON.card, key: 'billing' },
            { href: '/dashboard/help', label: 'Help & FAQ', icon: ICON.help, key: 'help' },
            ...(isAdmin ? [{ href: '/admin', label: 'Admin', icon: ICON.shield, key: 'admin' }] : []),
          ].map((n: any) => (
            <li><a href={n.href} class:list={['flex min-h-12 items-center gap-3 rounded-xl px-3 text-[15px] font-medium', active === n.key ? 'bg-brand-50 text-brand-700' : 'text-slate-700 hover:bg-slate-50']}>
              <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d={n.icon} /></svg>
              <span class="flex-1">{n.label}</span>
              {n.badge > 0 && <span class="rounded-full bg-rose-600 px-2 text-xs font-bold text-white">{n.badge}</span>}
            </a></li>
          ))}
          <li class="pt-1"><div class="px-1"><LogoutButton client:load /></div></li>
        </ul>
      </div>
    </div>
    <script is:inline>
      // Refresh dashboard data when you come back to the tab (e.g. after a customer books on their phone).
      // Skipped while a dialog is open or a field is being typed in, so nothing you are writing is lost.
      (function () {
        var hiddenAt = 0;
        document.addEventListener('visibilitychange', function () {
          if (document.hidden) { hiddenAt = Date.now(); return; }
          if (!hiddenAt || Date.now() - hiddenAt < 15000) return;
          var busy = document.querySelector('[role=dialog]') || (document.activeElement && /INPUT|TEXTAREA|SELECT/.test(document.activeElement.tagName));
          if (!busy) window.location.reload();
        });
      })();
    </script>
    <script is:inline>
      (function () {
        var sheet = document.getElementById('more-sheet');
        function open() { sheet.classList.remove('hidden'); sheet.classList.add('flex'); }
        function close() { sheet.classList.add('hidden'); sheet.classList.remove('flex'); }
        document.querySelectorAll('[data-more-open]').forEach(function (b) { b.addEventListener('click', open); });
        document.querySelectorAll('[data-more-close]').forEach(function (b) { b.addEventListener('click', close); });
        document.addEventListener('keydown', function (e) { if (e.key === 'Escape') close(); });
      })();
    </script>
  </div>
</BaseLayout>
