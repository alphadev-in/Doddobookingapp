---
import BaseLayout from './BaseLayout.astro';
import LogoutButton from '../components/islands/LogoutButton';

interface Props {
  title: string;
  active: 'overview' | 'calendar' | 'services' | 'team' | 'clients' | 'settings';
  businessName: string;
  bookingSlug: string;
}
const { title, active, businessName, bookingSlug } = Astro.props;

const nav = [
  { key: 'overview', href: '/dashboard', label: 'Home', icon: 'M3 12l9-9 9 9M5 10v10h14V10' },
  { key: 'calendar', href: '/dashboard/calendar', label: 'Calendar', icon: 'M3 5h18v16H3zM3 10h18M8 3v4M16 3v4' },
  { key: 'services', href: '/dashboard/services', label: 'Services', icon: 'M4 6h16M4 12h10M4 18h7' },
  { key: 'team', href: '/dashboard/team', label: 'Team', icon: 'M12 12a4 4 0 100-8 4 4 0 000 8zM4 21a8 8 0 0116 0' },
  { key: 'clients', href: '/dashboard/clients', label: 'Clients', icon: 'M16 11a4 4 0 10-8 0 4 4 0 008 0zM4 21a8 8 0 0116 0' },
];
---
<BaseLayout title={title} noindex>
  <div class="min-h-dvh md:flex">
    <!-- Desktop sidebar -->
    <aside class="hidden md:flex md:w-60 md:flex-col md:fixed md:inset-y-0 bg-white border-r border-slate-200 p-4">
      <a href="/dashboard" class="text-xl font-bold text-brand-600 px-2 py-3">Doddo</a>
      <p class="px-2 text-sm text-slate-500 truncate">{businessName}</p>
      <nav class="mt-6 flex flex-col gap-1" aria-label="Dashboard">
        {nav.map((n) => (
          <a href={n.href} aria-current={active === n.key ? 'page' : undefined}
            class:list={['flex items-center gap-3 rounded-lg px-3 py-2.5 text-sm font-medium', active === n.key ? 'bg-brand-50 text-brand-700' : 'text-slate-600 hover:bg-slate-100']}>
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d={n.icon} /></svg>
            {n.label}
          </a>
        ))}
        <a href="/dashboard/settings" aria-current={active === 'settings' ? 'page' : undefined}
          class:list={['flex items-center gap-3 rounded-lg px-3 py-2.5 text-sm font-medium', active === 'settings' ? 'bg-brand-50 text-brand-700' : 'text-slate-600 hover:bg-slate-100']}>
          Settings
        </a>
      </nav>
      <div class="mt-auto"><LogoutButton client:load /></div>
    </aside>

    <div class="flex-1 md:ml-60 min-w-0">
      <header class="sticky top-0 z-30 flex items-center justify-between gap-3 bg-white/90 backdrop-blur border-b border-slate-200 px-4 py-3">
        <div class="min-w-0">
          <p class="md:hidden text-xs text-slate-500 truncate">{businessName}</p>
          <h1 class="text-lg font-semibold truncate">{title}</h1>
        </div>
        <div class="flex items-center gap-2">
          <a href={`/book/${bookingSlug}`} target="_blank" rel="noopener" class="hidden sm:inline-flex items-center rounded-lg border border-slate-300 px-3 py-2 text-sm font-medium hover:bg-slate-50">View booking page</a>
          <a href="/dashboard/settings" class="md:hidden inline-flex h-11 w-11 items-center justify-center rounded-lg border border-slate-300" aria-label="Settings">
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3" /><path d="M12 2v3M12 19v3M4.2 4.2l2.1 2.1M17.7 17.7l2.1 2.1M2 12h3M19 12h3M4.2 19.8l2.1-2.1M17.7 6.3l2.1-2.1" /></svg>
          </a>
        </div>
      </header>
      <main id="main" class="anim-fade-up p-4 md:p-8 pb-28 md:pb-8 max-w-6xl mx-auto">
        <slot />
      </main>
    </div>

    <!-- Mobile bottom navigation -->
    <nav class="md:hidden fixed bottom-0 inset-x-0 z-40 bg-white border-t border-slate-200 pb-[env(safe-area-inset-bottom)]" aria-label="Primary">
      <ul class="grid grid-cols-5">
        {nav.map((n) => (
          <li>
            <a href={n.href} aria-current={active === n.key ? 'page' : undefined}
              class:list={['flex min-h-14 flex-col items-center justify-center gap-0.5 py-2 text-[11px] font-medium', active === n.key ? 'text-brand-600' : 'text-slate-500']}>
              <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d={n.icon} /></svg>
              {n.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</BaseLayout>
