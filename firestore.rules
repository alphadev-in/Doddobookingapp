rules_version = '2';
// The app reads and writes Firestore ONLY through the server (firebase-admin, which bypasses these rules).
// Browsers never talk to Firestore directly, so every collection is closed to client SDKs.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
